# ========================
# 应用基础配置
# ========================
NODE_ENV=development
APP_PORT=3000

# ========================
# TypeORM 配置 (MySQL示例)
# ========================
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_DATABASE=notice
DB_SYNCHRONIZE=true  # 生产环境必须设为 false
DB_LOGGING=true
DB_MIGRATIONS_RUN=true
DB_MAX_CONNECTIONS=10

# ========================
# Redis 配置 (ioredis)
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # 如果没有密码留空
REDIS_DB=0
REDIS_TTL=3600  # 默认缓存时间(秒)

# ========================
# MongoDB 配置
# ========================
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=noticeyou
MONGO_RETRY_WRITES=true
MONGO_RETRY_READS=true
MONGO_DIRECT_CONNECTION=true



# ========================
# 其他可选配置
# ========================
JWT_ACCRESS_SECRET=noticeyou
JWT_REFRESH_SECRET=notice
JWT_EXPIRES_IN=3600s
SSL_KEY_PATH=./server.key
SSL_CERT_PATH=./server.crt


# SMTP
SMTP_PORT=1026
SMTP_HOSTNAME=noticeyou.asia
SMTP_REQUIRE_AUTH=false
SMTP_MAX_CONCURRENCY=10

# mail
MAIL_USER=yourqq@qq.com
MAIL_PASS=fszkfrabzypmbdfg
MAIL_FROM=noticeyou
